# Todo esto es OPCIONAL: la app funciona sin ningún .env. Copia este archivo como .env solo si
# quieres cambiar algún ajuste (las líneas con valor son los valores por defecto).

# --- Twitch ---
# Solo si bifurcas el proyecto: ID de TU aplicación *pública* de dev.twitch.tv (sin secreto).
# TWITCH_CLIENT_ID=
# Vacío = el canal de la cuenta que conectas en el panel.
TWITCH_CHANNEL=
# Cada cuántos minutos se consulta Twitch en busca de VODs nuevos.
POLL_MINUTES=20

# --- Panel ---
PORT=8765

# --- Carpetas (fuera de OneDrive: un VOD pesa varios GB y no debe sincronizarse) ---
DATA_DIR=%LOCALAPPDATA%\DevStudioFCClips
CLIPS_DIR=%USERPROFILE%\Videos\FC Clips
# Borrar el VOD descargado al terminar sus clips.
KEEP_VODS=false

# --- Clips ---
# Segundos antes y después del gol. El "gol" es el último segundo en que el
# marcador aún mostraba el resultado anterior (CLIP_ANCHOR=last_old). Con
# first_new se ancla al primer segundo en que ya aparece el nuevo.
CLIP_BEFORE=15
CLIP_AFTER=3
CLIP_ANCHOR=last_old
# true = corte exacto (re-codifica). false = instantáneo pero empieza en el keyframe anterior.
CLIP_REENCODE=true

# --- Versión vertical para TikTok ---
# Crearla sola al terminar cada VOD (false = solo con el botón del panel).
TIKTOK_AUTO=true
# Segundos de jugada antes del gol, y repetición: segundos antes/después del gol y velocidad (0.5 = mitad).
TIKTOK_LEAD=10
TIKTOK_REPLAY_BEFORE=4.5
TIKTOK_REPLAY_AFTER=1
TIKTOK_REPLAY_SLOW=0.5
# Línea de abajo del vídeo y hashtags del texto del post.
TIKTOK_TAGLINE=EA FC · Clubes Pro
TIKTOK_HASHTAGS=#EAFC #ProClubs #ClubesPro #Gaming

# --- Descarga ---
# Calidad de los clips (se cortan del stream, bajando solo esos segundos).
YTDLP_FORMAT=best[height<=1080]/best
# Calidad que se descarga entera para detectar los goles. 480p lee con margen amplio
# (dígito correcto ≥0,96 frente a ≤0,78 del más parecido) y pesa la mitad que 720p.
# 360p también acierta pero con poco margen; 160p ya no se lee.
ANALYSIS_FORMAT=best[height<=480][height>=400]/best[height<=720]/best
YTDLP_FRAGMENTS=4
# Ruta a ffmpeg si no está en el PATH.
FFMPEG_PATH=ffmpeg
# Decodificación por GPU para analizar más rápido (p. ej. cuda, qsv, d3d11va). Vacío = CPU.
FFMPEG_HWACCEL=

# --- Detección (normalmente basta con la calibración del panel) ---
# Resolución a la que se calibran las plantillas; el vídeo se escala a esta antes de recortar.
REF_WIDTH=1920
REF_HEIGHT=1080
# Zona del marcador por defecto (el panel la sobrescribe al calibrar).
ROI_X=0
ROI_Y=0
ROI_W=480
ROI_H=240
LABEL_THRESHOLD=0.75
DIGIT_THRESHOLD=0.90
# Si otro dígito queda a menos de esto del mejor, la lectura se da por dudosa (no se adivina).
DIGIT_MARGIN=0.08
# Fotogramas seguidos con el mismo número para darlo por bueno (filtra lecturas sueltas).
STABLE_FRAMES=2
# Subidas mayores que esto en un solo paso se tratan como error de lectura (0 = sin límite).
MAX_JUMP=3
SAMPLE_FPS=1
MAX_ATTEMPTS=3
LOG_LEVEL=INFO
